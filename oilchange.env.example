# Copy to oilchange.env (gitignored) and fill in.
# oilchange loads oilchange.env automatically. Process env wins if already set.
# Never commit oilchange.env.

# --- working store ---
# SQLite is the daily driver (compute / serve / sync-enterprise). Keep this set.
OILCHANGE_DB=./oilchange.sqlite
# Local JSON for Oil Desk GET /api/cars (written by `oilchange sync`).
FLEET_MIRROR_PATH=web/data/cars.json

# --- Neon backup ---
# Unpooled only. Copy DATABASE_URL_UNPOOLED from `neon env pull` / .env.local.
# Hostname must NOT contain -pooler. Daily commands still use SQLite when OILCHANGE_DB is set.
# oilchange backup-neon copies local tables into this database.
# Never put a Supabase or XRAY URL here.
# DATABASE_URL=
# Optional Canon places catalog copy (read-only SELECT of existing Fleet_Manage_Oil.places).
# oilchange places-cache --from-neon  OR  --json /path/to/places.json
# OILCHANGE_PLACES_JSON=

# --- Oil Desk remote (Supabase fleet_cars) ---
# ZacharyTFerguson's Project (hdtwfdjdvdzdxfdriyzn). NEVER XRAY (chjqcznyxvtjbamttqdj).
SUPABASE_URL=https://hdtwfdjdvdzdxfdriyzn.supabase.co
# Publishable/anon (SELECT fleet_cars). Named key in the dashboard: Grok Build.
# SUPABASE_GROK_BUILD_KEY=
# Alias: SUPABASE_ANON_KEY=
# Uncomment one for `oilchange sync` to upsert fleet_cars (server-side only):
# SUPABASE_SERVICE_ROLE=
# SUPABASE_SYNC_SECRET=

# --- eFleets (optional live portal) ---
# Never paste username/password into chat, PRs, Slack, or commit them.
# Local: uncomment and fill this gitignored oilchange.env (copy from this example).
# Cloud Agent: add secrets named EFLEETS_USERNAME, EFLEETS_PASSWORD, EFLEETS_CUST_NUM
# (aliases EFleetsUsername / enterprise_login_name, EFleetsPassword / enterprise_password,
# EFleetsCustNum — same injection as OneStepAPIKEY).
# A single secret named efleets or Enterprise secrets also works (JSON or KEY=value blob).
# File-drop CSVs (--vehicles / --fuel-details) work without these.
EFLEETS_BASE_URL=https://login.efleets.com
# EFLEETS_USERNAME=
# EFLEETS_PASSWORD=
# EFLEETS_CUST_NUM=
# CSV export URLs from a logged-in DevTools copy (portal paths are not public):
# EFLEETS_DETAILS_URL=
# EFLEETS_MAINT_URL=
# EFLEETS_FLEETSUMMARY_URL=

# --- OneStep (needed for Last Reading) ---
# Paste the public API key. Do not paste it into chat.
# Aliases also load: ONESTEP_API_KEY, ONE_STEP_FULL_API_KEY, OneStepAPIKEYTobeSigned.
ONESTEP_BASE_URL=https://track.onestepgps.com
# ONESTEP_API_TOKEN=
# Optional JWT PEM (usage-note PKCS#8). Prefer a file path over inlining the block:
# ONESTEP_PEM_PATH=
# ONESTEP_API_PRIVATEKEY=
# ONESTEP_API_PUBLIC_KEY=
