# Copy to oilchange.env (gitignored) and fill in.
# oilchange loads oilchange.env automatically. Process env wins if already set.
# Never commit oilchange.env.

# --- database ---
# Neon Postgres from Grok Build. Do not wait on Supabase fleet-oil.
# SQLite is the offline / test path. Never XRAY.
# DATABASE_URL=
OILCHANGE_DB=./oilchange.sqlite

# --- eFleets ---
# Prefer an already-open Chrome eFleets session (no password typing).
# File-drop flags on sync-enterprise are the fallback when that session is missing.
# Do not treat username/password HTTP as always-on login.
# EFLEETS_USERNAME=
# EFLEETS_PASSWORD=
EFLEETS_CUST_NUM=
EFLEETS_BASE_URL=https://login.efleets.com
# Paste the CSV export URLs from a logged-in DevTools copy (portal paths are not public)
EFLEETS_DETAILS_URL=
EFLEETS_MAINT_URL=
EFLEETS_FLEETSUMMARY_URL=

# --- OneStep ---
# This account: mint RS256 JWS {access_token, exp} with the account PEM.
# Authorization: Bearer <jwt>. Not raw Bearer. Not ?api-key=.
# Cloud Agent secret names: OneStepAPIKEYTobeSigned (token) + OneStepAPIKEY (PEM).
ONESTEP_API_TOKEN=
# PKCS#8 PEM (multiline BEGIN/END PRIVATE KEY). Required with the token.
# ONESTEP_API_PRIVATEKEY=
# Or a file path: ONESTEP_PEM_PATH=/secure/path/to/onestep-client.pem
ONESTEP_BASE_URL=https://track.onestepgps.com
