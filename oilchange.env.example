# Copy to oilchange.env (gitignored) and fill in.
# oilchange loads oilchange.env automatically. Process env wins if already set.
# Never commit oilchange.env.

# --- database ---
# sqlite for this machine; DATABASE_URL later for Postgres
OILCHANGE_DB=./oilchange.sqlite
# DATABASE_URL=
#
# Supabase — existing shared project "ZacharyTFerguson's Project"
# ref: hdtwfdjdvdzdxfdriyzn  (fleet_* tables). NEVER XRAY (chjqcznyxvtjbamttqdj).
SUPABASE_URL=https://hdtwfdjdvdzdxfdriyzn.supabase.co
# Prefer service role for PostgREST upsert into fleet_cars (server-side only):
# SUPABASE_SERVICE_ROLE=
# Or fleet-sync edge function token (x-fleet-sync-token) when service role is unavailable:
# SUPABASE_SYNC_SECRET=
# Publishable/anon key is for the web UI read path (see web/.env.example).
# Local mirror for the UI when Supabase is unset:
# FLEET_MIRROR_PATH=web/data/cars.json

# --- eFleets live download ---
EFLEETS_USERNAME=
EFLEETS_PASSWORD=
EFLEETS_CUST_NUM=
EFLEETS_BASE_URL=https://login.efleets.com
# Paste the CSV export URLs from a logged-in DevTools copy (portal paths are not public)
EFLEETS_DETAILS_URL=
EFLEETS_MAINT_URL=
EFLEETS_FLEETSUMMARY_URL=

# --- OneStep ---
# API key aliases accepted: ONESTEP_API_TOKEN, ONESTEP_API_KEY, ONE_STEP_FULL_API_KEY
ONESTEP_API_TOKEN=
# PKCS#8 PEM from OneStep's usage note (multiline BEGIN/END PRIVATE KEY). Used for JWT RS256.
# ONESTEP_API_PRIVATEKEY=
# ONESTEP_API_PUBLIC_KEY=
# Or a file path (Cursor guide): ONESTEP_PEM_PATH=/secure/path/to/onestep-client.pem
ONESTEP_BASE_URL=https://track.onestepgps.com
