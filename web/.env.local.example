# Fleet Oil Desk web UI
# Copy to .env.local. Never commit secrets.
# Service role / sync secret must NEVER be NEXT_PUBLIC_*.

# Existing shared project: ZacharyTFerguson's Project (hdtwfdjdvdzdxfdriyzn)
# Tables: fleet_cars (anon SELECT). Never XRAY (chjqcznyxvtjbamttqdj).
NEXT_PUBLIC_SUPABASE_URL=https://hdtwfdjdvdzdxfdriyzn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Or legacy anon JWT from Project Settings → API.

# Poll cadence for the durable day surface (ms)
NEXT_PUBLIC_REFRESH_MS=120000

# When Supabase is unset, /api/cars reads ../data/cars.json (written by `oilchange sync`).
